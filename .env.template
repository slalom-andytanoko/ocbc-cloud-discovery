# Discovery Toolkit — Environment Configuration Template
# Generated by setup.py. Copy to .env and run: python setup.py
# Placeholders are resolved automatically by the setup wizard.

# ─── Client Identity ───────────────────────────────────────────────────────────

# Client name used in deliverables, steering files, and presentations
# Format: plain text, max 100 characters (e.g., "Acme Corp")
CLIENT_NAME={{CLIENT_NAME}}

# Client GitHub organisation for IaC repo references
# Format: GitHub org name without URL prefix (e.g., "Acme-Group")
CLIENT_GITHUB_ORG={{CLIENT_GITHUB_ORG}}

# ─── Confluence Integration ────────────────────────────────────────────────────

# Base URL for the client's Confluence instance (used by ingest-confluence and publish-confluence)
# Format: https://<site>.atlassian.net/wiki
CONFLUENCE_BASE_URL={{CONFLUENCE_BASE_URL}}

# Confluence space key where discovery pages live
# Format: short uppercase key (e.g., "IAT", "DISC")
CONFLUENCE_SPACE_KEY={{CONFLUENCE_SPACE_KEY}}

# Confluence cloud ID for API calls (find via <site>.atlassian.net/_edge/tenant_info)
# Format: UUID string (e.g., "a1b2c3d4-e5f6-7890-abcd-ef1234567890")
CONFLUENCE_CLOUD_ID={{CONFLUENCE_CLOUD_ID}}

# Email address associated with your Atlassian account (for REST API auth)
# Format: email address (e.g., "you@slalom.com")
CONFLUENCE_EMAIL={{CONFLUENCE_EMAIL}}

# Atlassian API token for Confluence access
# Generate at: https://id.atlassian.com/manage-profile/security/api-tokens
# Format: alphanumeric token string
CONFLUENCE_API_TOKEN={{CONFLUENCE_API_TOKEN}}

# ─── AWS Configuration ─────────────────────────────────────────────────────────

# Default AWS region for CLI operations and resource queries
# Format: AWS region code (e.g., "ap-southeast-2", "us-east-1")
AWS_DEFAULT_REGION={{AWS_DEFAULT_REGION}}

# ─── Consultant Identity ───────────────────────────────────────────────────────

# Your name/alias for team-commentary attribution and commit context
# Format: plain text matching domain glossary Known Speakers (e.g., "Jamie")
WIKI_USER={{WIKI_USER}}

# ─── Deliverables Configuration ────────────────────────────────────────────────

# Output mode for generated deliverables: "draft" adds watermark, "prod" for clean output
# Format: draft | prod
DELIVERABLES_MODE={{DELIVERABLES_MODE}}

# Estimation buffer applied to phase/grand totals (not per-item)
# Format: decimal multiplier — 1.0 = no buffer, 1.3 = 30% margin, 1.5 = 50% margin
ESTIMATION_BUFFER={{ESTIMATION_BUFFER}}

# Path to the client deliverables submodule (used by discovery-deliverables skill)
# Format: relative or absolute path to the client-deliverables directory
# Leave empty if client deliverables repo is not configured
CLIENT_DELIVERABLES_PATH={{CLIENT_DELIVERABLES_PATH}}

# ─── Vault Paths ──────────────────────────────────────────────────────────────

# Absolute path to the Obsidian vault root (usually this repo's root)
# Format: absolute filesystem path (e.g., "/Users/you/projects/client-discovery")
OBSIDIAN_VAULT_PATH={{OBSIDIAN_VAULT_PATH}}

# Path to the obsidian-wiki skill repo (wiki framework submodule)
# Format: absolute path to .skill-repos/obsidian-wiki or equivalent
OBSIDIAN_WIKI_REPO={{OBSIDIAN_WIKI_REPO}}

# ─── QMD Semantic Search (optional) ───────────────────────────────────────────
# QMD enables semantic search over wiki pages and source documents.
# Install: https://github.com/tobi/qmd
# Without QMD: wiki-query falls back to grep/glob — fully functional, just slower.

# Name of the QMD collection indexing compiled wiki pages
QMD_WIKI_COLLECTION=

# Name of the QMD collection indexing raw source documents (docs/ and _raw/)
QMD_PAPERS_COLLECTION=

# Transport: mcp (default) | cli
QMD_TRANSPORT=mcp
